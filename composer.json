{
    "name": "jdz/adminui",
    "type": "library",
    "description": "Framework-agnostic admin UI rendering (list, columns, triggers, toolbar) and shared admin controller traits",
    "keywords": [
        "JDZ",
        "utilities",
        "html",
        "twig",
        "admin",
        "ui"
    ],
    "homepage": "https://jdz.joffreydemetz.com/adminui",
    "license": "MIT",
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2",
        "jdz/htmlrenderer": "^1.0",
        "jdz/data": "^2.0",
        "jdz/form": "^1.0",
        "jdz/ui": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "jdz/mediamanager": "^2.0",
        "symfony/http-foundation": "^7.4",
        "slim/psr7": "^1.6"
    },
    "suggest": {
        "jdz/mediamanager": "Required by JDZ\\AdminUi\\Controller\\MediasControllerTrait — the media library engine it drives",
        "symfony/http-foundation": "Required by JDZ\\AdminUi\\Controller\\MediasControllerTrait — the uploaded-file type jdz/mediamanager speaks"
    },
    "autoload": {
        "psr-4": {
            "JDZ\\AdminUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\AdminUi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox",
        "test-coverage": "phpunit --coverage-html coverage"
    }
}
